# Growth OS configuration. Copy to .env and fill in. Never commit .env.
# The server holds NO AI, search or contact keys: every operator saves their own under "API keys & spend".

# --- required in production ---------------------------------------------------------------------------------
APP_ENV=production                 # production | demo (synthetic data, local only) | test
APP_BASE_URL=https://your-host.example.com
JWT_SECRET=                        # 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=                    # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEYS=new,old          # rotation: the first encrypts, all decrypt (use instead of ENCRYPTION_KEY)
DATABASE_URL=                      # postgres://...?sslmode=require (Neon, Supabase...) or sqlite+aiosqlite:///./data/growthos.db

# Sign in with Google (Google Cloud console -> APIs & Services -> Credentials -> OAuth client, type "Web application").
# Authorised redirect URI: APP_BASE_URL/auth/google/callback. Scopes: openid email profile.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- optional -----------------------------------------------------------------------------------------------
ALLOWED_EMAILS=                    # comma-separated; empty = anyone with a Google account may sign in
CONTACT_EMAIL=                     # shown on the privacy policy page for data requests
# MODEL_ROUTES_JSON={"groq": {"big": ["openai/gpt-oss-120b"]}}    # development: override the model table
# MODEL_LIMITS_JSON={"openai/gpt-oss-120b": {"tpm": 250000, "rpm": 300}}   # a paid Groq plan's per-model limits

# --- development scripts and evals only (the app never reads these) -----------------------------------------
# scripts/live_*.py save these into a test account through the same service the UI uses.
GROQ_API_KEY=
TAVILY_API_KEY=
HUNTER_API_KEY=
TEST_DATABASE_URL=                 # a separate database or Neon branch for tests; never the production one
