# Copy to .env and fill in. Never commit .env. Production is the default mode: no mock data, no demo accounts.
APP_ENV=production
APP_BASE_URL=http://localhost:8000          # public https URL when deployed (OAuth redirect + secure cookies)
DATABASE_URL=sqlite+aiosqlite:///./growthos.db   # use a persistent disk path in production
JWT_SECRET=                                  # REQUIRED, 32+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"

# AI models (required for research and drafting)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_MODE=auto                                # auto | live. "mock" is refused in production
# Optional model routing per tier: comma-separated "provider:model" fallback chains. Free-tier limits are per model,
# so each tier leads with a different model and spills over to the next when its limit would make a call wait.
# Defaults: big=gpt-oss-120b,qwen3.8-27b  research/small=gpt-oss-20b,qwen3.8-27b,gemini  extract/judge=gemini first
ROUTE_BIG=
ROUTE_RESEARCH=
ROUTE_SMALL=
ROUTE_EXTRACT=
ROUTE_JUDGE=
ROUTE_GUARD=
MODEL_LIMITS_JSON=                           # e.g. {"gemini-3.5-flash-lite": {"tpm": 250000, "rpm": 15}}

# Web search: one is required for research
TAVILY_API_KEY=                              # free tier at tavily.com
GOOGLE_API_KEY=                              # Gemini judge + Google Search grounding (grounding needs billing)

# Optional integrations (off until set)
HUNTER_API_KEY=                              # hunter.io: find and verify lead emails
GOOGLE_OAUTH_CLIENT_ID=                      # Gmail sending (GOOGLE_CLIENT_ID is accepted too)
GOOGLE_OAUTH_CLIENT_SECRET=                  # (GOOGLE_CLIENT_SECRET is accepted too)
GOOGLE_REDIRECT_URI=                         # must match Google Cloud exactly; default APP_BASE_URL/oauth/google/callback (also served at /auth/gmail/callback)
ENCRYPTION_KEY=                              # Fernet key for stored OAuth tokens (derived from JWT_SECRET if empty)

# Operations (optional)
SIGNUP_INVITE_CODE=                          # if set, signup requires it
ADMIN_EMAIL=                                 # creates a platform admin at startup
ADMIN_PASSWORD=
GLOBAL_DAILY_BUDGET_USD=5
SELF_SERVE_MONTHLY_BUDGET_USD=2
