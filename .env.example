# Copy to .env. Without GROQ_API_KEY the app runs in mock mode (deterministic, offline).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: Gemini judge model + Google-Search-grounded research (falls back to Qwen judge / seeded corpus)
GOOGLE_API_KEY=
# live | mock | auto (auto = live when GROQ_API_KEY is set)
LLM_MODE=auto
DATABASE_URL=sqlite+aiosqlite:///./growthos.db
JWT_SECRET=change-me
